# Copy to .env and adjust. Never commit .env.

# Port the API listens on. The frontend's VITE_API_BASE_URL should point at http://localhost:<PORT>/api
PORT=3000

# The frontend origin allowed by CORS (exact origin, never "*" with credentials).
# Vite dev server is 5173, `vite preview` is 4173. Comma-separate to allow both.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Local PostgreSQL started by `docker run ... -p 5433:5432` (see README section 7).
DATABASE_URL=postgresql://ship:ship_dev_password@localhost:5433/ship

# Keys the hash of email sign-in codes. Generate one with: openssl rand -base64 36
# Must be a real secret in production.
AUTH_SECRET=replace-with-a-long-random-string

# DEVELOPMENT ONLY. No mail service exists yet, so the sign-in code is printed to the server log.
# true also returns it in the response as `mockVerificationCode` so the frontend can show it.
# The server refuses to start with this set to true when NODE_ENV=production.
AUTH_DEV_RETURN_CODE=true

# How long a sign-in lasts.
SESSION_TTL_DAYS=30
