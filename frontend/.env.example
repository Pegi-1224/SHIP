# ---------------------------------------------------------------------------
# SHIP frontend environment configuration
#
# Copy this file to `.env` and adjust values for your machine:
#   cp .env.example .env
#
# SECURITY: every variable prefixed with VITE_ is inlined into the JavaScript
# bundle at build time and is therefore PUBLIC. It is visible to anyone who
# opens the site. Never put API keys, server secrets, private keys, database
# credentials or OAuth client secrets in this file.
# ---------------------------------------------------------------------------

# Base URL that the shared API client prefixes onto every request path.
# Use a relative path ("/api") so the dev-server proxy or the hosting platform
# can route it, or an absolute origin ("https://api.example.com") when the
# backend lives elsewhere.
VITE_API_BASE_URL=/api

# "true"  -> Mock Service Worker starts and intercepts every API request.
#            No backend is required. All data is fictional demonstration data.
# "false" -> MSW never starts. Requests go to VITE_API_BASE_URL for real.
#            Failures surface as real errors; there is no mock fallback.
VITE_ENABLE_MOCKS=true
